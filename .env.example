DB_PATH=../jp-invest-data/db.sqlite
LLM_PROVIDER_TYPE=mock
OLLAMA_API_KEY=your-api-key-here
OLLAMA_MODEL=kimi-k2.7-code:cloud
OLLAMA_API_URL=https://ollama.com/api
RESEARCH_SOURCE_MODE=mock
# Required only when RESEARCH_SOURCE_MODE=live. SEC requires an app name and contact email.
SEC_USER_AGENT=JP Invest your-email@example.com
# Optional; defaults beside DB_PATH and must remain outside the repository.
SOURCE_SNAPSHOT_DIR=../jp-invest-data/source-snapshots
# Optional; defaults to ignored logs/outbound.log.
OUTBOUND_LOG_PATH=logs/outbound.log
# Required for /api/internal/research/cron. Send as Authorization: Bearer <secret>.
RESEARCH_CRON_SECRET=replace-with-a-long-random-secret
# Displayed schedule metadata; the local Windows task is the scheduling authority.
RESEARCH_REFRESH_SCHEDULE=0 8 * * *
# JSON map of tracked tickers to trusted official investor-relations pages.
ISSUER_SOURCE_URLS={"BBRI":"https://www.ir-bri.com/financials.html"}
# M007 Class A. JSON map of tracked tickers to allowlisted issuer press-release
# pages (secondary evidence, never official). Example verified live 2026-07-26
# (real HTTP 200, real discoverable same-host "/news/..." article links) —
# note BBRI's own IR site (ir-bri.com) was tried first and rejected: its
# press-release links route through a same-origin redirect tracker on a
# *different* domain (ir.listedcompany.com), which the adapter's host-matching
# correctly refuses to follow. Don't assume every issuer site works this
# cleanly; verify before configuring a new ticker.
ISSUER_PRESS_RELEASE_URLS={"TLKM":"https://www.telkom.co.id/sites/berita/id_ID/page/news-about-telkom-122"}
# M007 Class B. JSON map of publisher name to allowlisted RSS/Atom/JSON feed URL.
# Example verified live 2026-07-26 (real HTTP 200, every <link> same-origin as
# the feed — NewsWireAdapter's requirement). General-market, not
# ticker-specific: yields evidence only on days a tracked ticker is in the news.
NEWS_WIRE_FEED_URLS={"CNBC Indonesia Market":"https://www.cnbcindonesia.com/market/rss"}
# M008 Class C. API key for the search-discovery provider under evaluation
# (currently Tavily). Discovery returns candidate URLs only — never evidence.
# Unset by default: the eval's deterministic mode needs no key, and live mode
# fails closed without one.
SEARCH_DISCOVERY_API_KEY=
# Silences upstream dotenv promotional startup tips repository-wide.
DOTENV_CONFIG_QUIET=true
