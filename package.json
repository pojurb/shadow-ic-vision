{
  "name": "jp-invest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live-sources": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "context:generate": "node --import ./node_modules/tsx/dist/loader.mjs scripts/context-index.ts --write",
    "context:check": "node --import ./node_modules/tsx/dist/loader.mjs scripts/context-index.ts --check",
    "status:check": "node --import ./node_modules/tsx/dist/loader.mjs scripts/status-check.ts",
    "verify": "node --import ./node_modules/tsx/dist/loader.mjs scripts/verify.ts",
    "verify:full": "node --import ./node_modules/tsx/dist/loader.mjs scripts/verify.ts --full",
    "eval:m001:multimodal": "node --import ./node_modules/tsx/dist/loader.mjs scripts/eval-m001-multimodal.ts",
    "eval:m001:provider": "node --import ./node_modules/tsx/dist/loader.mjs scripts/eval-m001-provider.ts",
    "eval:m008:discovery": "node --import ./node_modules/tsx/dist/loader.mjs scripts/eval-m008-discovery.ts",
    "eval:m008:discovery:aggregate": "node --import ./node_modules/tsx/dist/loader.mjs scripts/eval-m008-discovery-aggregate.ts",
    "research:refresh": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/research-refresh.ts",
    "research:promote-discoveries": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/promote-discoveries.ts",
    "research:cleanup-evidence": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/cleanup-boilerplate-evidence.ts",
    "research:cleanup-promotions": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/cleanup-mislabelled-promotions.ts",
    "research:panel": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/research-panel.ts",
    "research:queue": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/research-queue.ts",
    "research:retry": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/research-retry.ts",
    "thesis:stage": "node --conditions=react-server --import ./node_modules/tsx/dist/loader.mjs scripts/thesis-stage.ts",
    "research:install-task": "powershell -ExecutionPolicy Bypass -File scripts/install-research-task.ps1",
    "fixtures:vision:generate": "node --import ./node_modules/tsx/dist/loader.mjs scripts/generate-vision-fixtures.ts"
  },
  "dependencies": {
    "ai": "^7.0.14",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
